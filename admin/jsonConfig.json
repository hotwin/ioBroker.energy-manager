{
  "type": "panel",
  "items": {
    "tariffConfigured": {
      "type": "checkbox",
      "label": "Tarifbestandteile geprüft"
    },
    "markupCt": {
      "type": "number",
      "label": {
        "de": "Weitere Netto-Aufschläge, ohne separat erfasste Beträge (ct/kWh)",
        "en": "Other net surcharges excluding separately entered amounts (ct/kWh)"
      },
      "min": 0
    },
    "vatPercent": {
      "type": "number",
      "label": "Mehrwertsteuer (%)",
      "min": 0
    },
    "autoShelly": {
      "type": "checkbox",
      "label": {
        "de": "Shelly automatisch erkennen",
        "en": "Automatically discover Shelly"
      }
    },
    "sources": {
      "type": "table",
      "label": {
        "de": "Manuelle Energiequellen",
        "en": "Manual energy sources"
      },
      "items": [
        {
          "type": "text",
          "attr": "name",
          "title": "Name"
        },
        {
          "type": "text",
          "attr": "room",
          "title": "Raum / Room"
        },
        {
          "type": "objectId",
          "attr": "powerId",
          "title": "Leistung / Power (W)"
        },
        {
          "type": "objectId",
          "attr": "energyId",
          "title": "Energie / Energy"
        },
        {
          "type": "select",
          "attr": "unit",
          "title": "Unit",
          "options": [
            {
              "label": "Wh",
              "value": "Wh"
            },
            {
              "label": "kWh",
              "value": "kWh"
            }
          ]
        },
        {
          "type": "checkbox",
          "attr": "exclude",
          "title": "Exclude from total"
        }
      ]
    },
    "baseMonthly": {
      "type": "number",
      "label": {
        "de": "Grundgebühr netto (€/Monat)",
        "en": "Monthly base charge net (EUR)"
      },
      "min": 0
    },
    "meterAnnual": {
      "type": "number",
      "label": {
        "de": "Messstellenbetrieb zusätzlich netto (€/Jahr)",
        "en": "Additional annual metering net (EUR)"
      },
      "min": 0
    },
    "electricityTaxCt": {
      "type": "number",
      "label": {
        "de": "Stromsteuer netto (ct/kWh)",
        "en": "Electricity tax net (ct/kWh)"
      },
      "min": 0
    },
    "networkCt": {
      "type": "number",
      "label": {
        "de": "Netzentgelte netto (ct/kWh)",
        "en": "Network charges net (ct/kWh)"
      },
      "min": 0
    },
    "concessionCt": {
      "type": "number",
      "label": {
        "de": "Konzessionsabgabe netto (ct/kWh)",
        "en": "Concession fee net (ct/kWh)"
      },
      "min": 0
    },
    "leviesCt": {
      "type": "number",
      "label": {
        "de": "Umlagen netto (ct/kWh)",
        "en": "Levies net (ct/kWh)"
      },
      "min": 0
    },
    "advanceMonthly": {
      "type": "number",
      "label": {
        "de": "Abschlag brutto (€/Monat)",
        "en": "Monthly advance gross (EUR)"
      },
      "min": 0
    },
    "contractStart": {
      "type": "text",
      "label": {
        "de": "Vertragsbeginn (JJJJ-MM-TT)",
        "en": "Contract start (YYYY-MM-DD)"
      }
    }
  }
}
{
  "name": "iobroker.hotwin-energy-manager",
  "version": "0.6.1",
  "description": "Local electricity monitoring, tariff and cost analysis, and solar and battery readings for ioBroker",
  "main": "main.js",
  "license": "MIT",
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test:unit && npm run test:package",
    "test:unit": "node --test test/*.test.js",
    "test:package": "mocha test/metadata.package.js",
    "test:integration": "mocha test/adapter.integration.js",
    "test:compact": "mocha --grep \"Compact mode\" test/adapter.integration.js",
    "sync:dashboard": "node scripts/sync-dashboard.js",
    "check:dashboard": "node scripts/sync-dashboard.js --check",
    "release": "release-script"
  },
  "author": "hotwin <hotwin@gmx.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hotwin/ioBroker.hotwin-energy-manager.git"
  },
  "bugs": {
    "url": "https://github.com/hotwin/ioBroker.hotwin-energy-manager/issues"
  },
  "homepage": "https://github.com/hotwin/ioBroker.hotwin-energy-manager#readme",
  "keywords": [
    "ioBroker",
    "energy",
    "power",
    "monitoring"
  ],
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@eslint/js": "^9.39.5",
    "@iobroker/testing": "^6.3.3",
    "eslint": "^9.39.5",
    "globals": "^17.14.0"
  },
  "files": [
    "main.js",
    "lib/",
    "admin/",
    "www/",
    "doc/",
    "io-package.json",
    "LICENSE"
  ]
}
